#, php-format
msgid "Activating %s will limit Airo features"
msgstr "Kích hoạt%s sẽ hạn chế các tính năng của Airo"

#: includes/compat/class-compatibility-modal.php:201
msgid "Certain plugins limit what Airo for WordPress can do for your site. To keep all of Airo's design capabilities, cancel this activation."
msgstr "Một số plugin hạn chế những khả năng Airo cho WordPress có thể mang lại cho trang web của bạn. Để giữ nguyên tất cả các khả năng thiết kế của Airo, hãy huỷ kích hoạt."

#: includes/compat/class-compatibility-modal.php:202
msgid "Certain themes limit what Airo for WordPress can do for your site. To keep all of Airo's design capabilities, cancel this activation."
msgstr "Một số giao diện hạn chế những khả năng Airo cho WordPress có thể mang lại cho trang web của bạn. Để giữ nguyên tất cả các khả năng thiết kế của Airo, hãy huỷ kích hoạt."

#: includes/compat/class-compatibility-modal.php:203
msgid "This plugin is under review. It may or may not cause issues with Airo."
msgstr "Plugin này đang được đánh giá. Plugin có thể có hoặc không gây ra sự cố với Airo."

#: includes/compat/class-compatibility-modal.php:204
msgid "Continue Anyway"
msgstr "Vẫn cứ tiếp tục"

#: includes/compat/class-compatibility-modal.php:205
msgid "Cancel Activation"
msgstr "Huỷ kích hoạt"

#: includes/compat/class-compatibility-modal.php:206
msgid "Don't show plugin warnings again"
msgstr "Không hiển thị lại cảnh báo về plugin"

#: includes/compat/class-compatibility-modal.php:207
msgid "Don't show theme warnings again"
msgstr "Không hiển thị lại cảnh báo về giao diện"

