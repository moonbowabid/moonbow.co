#: includes/extensions/class-draft-mode.php:150
msgid "Airo Draft"
msgstr "Чернетка Airo"

#. translators: %s is the original page title.
#: includes/extensions/class-draft-mode.php:182
#, php-format
msgid "Airo draft of: %s"
msgstr "Чернетка Airo: %s"

#: includes/extensions/class-draft-mode.php:186
msgid "Draft Version"
msgstr "Чернетка"

#. translators: %s is the date the Airo draft was created.
#: includes/extensions/class-draft-mode.php:202
#, php-format
msgid "Airo draft created: %s"
msgstr "Створено чернетку Airo: %s"

#: includes/extensions/class-draft-mode.php:206
msgid "Has Draft"
msgstr "Має чернетку"

#: includes/extensions/class-draft-mode.php:116
msgid "The original page no longer exists."
msgstr "Сторінки-першоджерела більше не існує."

#: includes/extensions/class-draft-mode.php:128
msgid "The original page already has an active draft."
msgstr "Для цієї сторінки-першоджерела вже є діюча чернетка."

#: includes/extensions/class-draft-mode.php:140
msgid "Failed to restore the draft from trash."
msgstr "Не вдалося повернути чернетку з кошика."

#: includes/extensions/class-draft-mode.php:162
msgid "Failed to force the restored draft back to draft status."
msgstr "Не вдалося повернути відновлену чернетку до стану чернетки."

#: includes/extensions/class-draft-mode.php:177
msgid "The draft was restored from trash but could not be re-linked to its original page."
msgstr "Цю чернетку було повернуто з кошика, але її не вдалося знову пов’язати зі сторінкою-першоджерелом."
